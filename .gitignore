# The prebuilt Orin binaries are tracked on purpose -- see prebuilt/README.md.
# The catch-all "*" above ignores extension-less files, and "lib/" ignores any
# directory named lib, so both have to be undone here explicitly.
!prebuilt/orin-jp6/lib/
!prebuilt/orin-jp6/lib/*
!prebuilt/orin-jp6/bin/
!prebuilt/orin-jp6/bin/*
!prebuilt/orin-jp6/licenses/
!prebuilt/orin-jp6/licenses/*

# ---------------------------------------------------------------------------------------------
# Our evaluation work (eval/): only code, eval/README.md (the report) with its figures, the ablation
# table and the ground truth are tracked; everything else stays local
# ---------------------------------------------------------------------------------------------
# reference papers, demo video, planning notes and presentation drafts (repository root)
/2608.17874v1.pdf
/Data_Flow_ORB-SLAM_for_Real-time_Performance_on_Embedded_GPU_Boards.pdf
/verification.mp4
/plan/
/presentation/
# report and slides stay local (PDFs, LaTeX sources, figures, figure scripts, notes); the report's content
# is in eval/README.md, with its figures in eval/figures/
/eval/report/
/eval/presentation/
# results: only results/husky/ablation_cells.json and reference/ (the ground truth and how it was built).
# Raw run outputs, per-run JSON, generated run reports and our D435 campaigns stay local.
/eval/results/d435_*/
/eval/results/husky/stage1/
/eval/results/husky/ablation/
/eval/results/husky/ANALYSIS.md
# Python caches
__pycache__/
# The catch-all "time*" rule above would hide the reference sequence's frame list
!/eval/results/husky/reference/sequence/times.txt
